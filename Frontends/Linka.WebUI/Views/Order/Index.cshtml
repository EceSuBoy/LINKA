@model CreateOrderAddressDto

@{
    ViewData["Title"] = "Checkout";
    Layout = "~/Views/UILayout/_UILayout.cshtml";
}

<div class="container-fluid">

    <form asp-controller="Order"
          asp-action="Index"
          method="post">

        @Html.AntiForgeryToken()

        <div class="row px-xl-5">

            <div class="col-12">
                <div asp-validation-summary="ModelOnly"
                     class="alert alert-danger">
                </div>
            </div>

            <div class="col-lg-8">

                <h5 class="section-title position-relative text-uppercase mb-3">
                    <span class="bg-secondary pr-3">
                        Shipping and Billing Address
                    </span>
                </h5>

                <div class="bg-light p-30 mb-5">

                    <div class="row">

                        <div class="col-md-6 form-group">
                            <label>First Name</label>
                            <input class="form-control"
                                   type="text"
                                   placeholder="Name"
                                   asp-for="Name" />
                            <span asp-validation-for="Name"
                                  class="text-danger">
                            </span>
                        </div>

                        <div class="col-md-6 form-group">
                            <label>Last Name</label>
                            <input class="form-control"
                                   type="text"
                                   placeholder="Surname"
                                   asp-for="Surname" />
                            <span asp-validation-for="Surname"
                                  class="text-danger">
                            </span>
                        </div>

                        <div class="col-md-6 form-group">
                            <label>E-mail</label>
                            <input class="form-control"
                                   type="email"
                                   placeholder="example@email.com"
                                   asp-for="Email" />
                            <span asp-validation-for="Email"
                                  class="text-danger">
                            </span>
                        </div>

                        <div class="col-md-6 form-group">
                            <label>Phone Number</label>
                            <input class="form-control"
                                   type="tel"
                                   placeholder="+90 123 456 78 90"
                                   asp-for="Phone" />
                            <span asp-validation-for="Phone"
                                  class="text-danger">
                            </span>
                        </div>

                        <div class="col-md-12 form-group">
                            <label>Address Line 1</label>
                            <input class="form-control"
                                   type="text"
                                   placeholder="Street, building and apartment"
                                   asp-for="Detail1" />
                            <span asp-validation-for="Detail1"
                                  class="text-danger">
                            </span>
                        </div>

                        <div class="col-md-12 form-group">
                            <label>Address Line 2</label>
                            <input class="form-control"
                                   type="text"
                                   placeholder="Optional additional information"
                                   asp-for="Detail2" />
                            <span asp-validation-for="Detail2"
                                  class="text-danger">
                            </span>
                        </div>

                        <div class="col-md-6 form-group">
                            <label>Country</label>
                            <input class="form-control"
                                   type="text"
                                   placeholder="Turkey"
                                   asp-for="Country" />
                            <span asp-validation-for="Country"
                                  class="text-danger">
                            </span>
                        </div>

                        <div class="col-md-6 form-group">
                            <label>City</label>
                            <input class="form-control"
                                   type="text"
                                   placeholder="Istanbul"
                                   asp-for="City" />
                            <span asp-validation-for="City"
                                  class="text-danger">
                            </span>
                        </div>

                        <div class="col-md-6 form-group">
                            <label>District</label>
                            <input class="form-control"
                                   type="text"
                                   placeholder="District"
                                   asp-for="District" />
                            <span asp-validation-for="District"
                                  class="text-danger">
                            </span>
                        </div>

                        <div class="col-md-6 form-group">
                            <label>ZIP Code</label>
                            <input class="form-control"
                                   type="text"
                                   placeholder="34000"
                                   asp-for="ZipCode" />
                            <span asp-validation-for="ZipCode"
                                  class="text-danger">
                            </span>
                        </div>

                    </div>

                </div>

            </div>

            <div class="col-lg-4">

                <h5 class="section-title position-relative text-uppercase mb-3">
                    <span class="bg-secondary pr-3">
                        Order Summary
                    </span>
                </h5>

                @await Component.InvokeAsync(
                "_OrderSummaryComponentPartial")

                @await Component.InvokeAsync(
                                "_PaymentMethodComponentPartial")

            </div>

        </div>

    </form>

</div>
@model CreateOrderAddressDto

@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/UILayout/_UILayout.cshtml";
}

<div class="container-fluid">
    <form method="post">
    <div class="row px-xl-5">
        
        <div class="col-lg-8">
            <h5 class="section-title position-relative text-uppercase mb-3"><span class="bg-secondary pr-3">Shipping and Billing Address</span></h5>
            <div class="bg-light p-30 mb-5">
                <div class="row">
                    <div class="col-md-6 form-group">
                        <label>First Name</label>
                        <input class="form-control" type="text" placeholder="Name" asp-for="Name">
                    </div>
                    <div class="col-md-6 form-group">
                        <label>Last Name</label>
                            <input class="form-control" type="text" placeholder="Surname" asp-for="Surname">
                    </div>
                    <div class="col-md-6 form-group">
                        <label>E-mail</label>
                            <input class="form-control" type="text" placeholder="example@email.com" asp-for="Email">
                    </div>
                    <div class="col-md-6 form-group">
                        <label>Phone Number</label>
                            <input class="form-control" type="text" placeholder="+90 123 456 78 90" asp-for="Phone">
                    </div>
                    <div class="col-md-6 form-group">
                        <label>Address Line 1</label>
                            <input class="form-control" type="text" placeholder="123 Street" asp-for="Detail1">
                    </div>
                    <div class="col-md-6 form-group">
                        <label>Address Line 2</label>
                            <input class="form-control" type="text" placeholder="123 Street" asp-for="Detail2">
                    </div>
                    <div class="col-md-6 form-group">
                        <label>Country</label>
                            <input class="form-control" type="text" placeholder="Turkey" asp-for="Country">
                    </div>
                    <div class="col-md-6 form-group">
                        <label>City</label>
                            <input class="form-control" type="text" placeholder="New York" asp-for="City">
                    </div>
                    <div class="col-md-6 form-group">
                        <label>State</label>
                            <input class="form-control" type="text" placeholder="New York" asp-for="District">
                    </div>
                    <div class="col-md-6 form-group">
                        <label>ZIP Code</label>
                            <input class="form-control" type="text" placeholder="123" asp-for="ZipCode">
                    </div>
                </div>
            </div>
        </div>

        
        <div class="col-lg-4">
            <h5 class="section-title position-relative text-uppercase mb-3"><span class="bg-secondary pr-3">Order Summary</span></h5>

            @await Component.InvokeAsync("_OrderSummaryComponentPartial")

             @await Component.InvokeAsync("_PaymentMethodComponentPartial")


            </div>
        </form>
    </div>
</div>

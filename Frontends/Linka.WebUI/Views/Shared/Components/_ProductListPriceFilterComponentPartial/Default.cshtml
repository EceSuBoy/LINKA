@model Linka.WebUI.Models.ProductListPriceFilterViewModel

<div class="mb-4">

    <h5 class="section-title position-relative text-uppercase mb-3">

        <span class="bg-secondary pr-3">
            Filter by Price
        </span>

    </h5>

    <div class="bg-light p-4">

        @foreach (var range in Model.PriceRanges)
        {
            var isSelected =
            range.MinPrice == Model.SelectedMinPrice &&
            range.MaxPrice == Model.SelectedMaxPrice;

            <a asp-controller="ProductList"
               asp-action="Index"
               asp-route-id="@Model.CategoryId"
               asp-route-minPrice="@range.MinPrice"
               asp-route-maxPrice="@range.MaxPrice"
               asp-route-sort="@Model.Sort"
               asp-route-pageSize="@Model.PageSize"
               asp-route-page="1"
               class="d-flex align-items-center justify-content-between text-body text-decoration-none py-2">

                <span>

                    @if (isSelected)
                    {
                        <i class="fas fa-check-square text-primary mr-2"></i>
                    }
                    else
                    {
                        <i class="far fa-square mr-2"></i>
                    }

                    @range.Label

                </span>

                <span class="badge border font-weight-normal">
                    @range.ProductCount
                </span>

            </a>
        }

    </div>

</div>
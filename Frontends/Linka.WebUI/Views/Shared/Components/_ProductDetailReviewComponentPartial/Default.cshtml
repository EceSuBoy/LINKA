@using Linka.DtoLayer.CommentDtos

@model List<ResultCommentDto>

@{
    var activeComments =
        Model?
            .Where(x => x.Status == true)
            .ToList()
        ?? new List<ResultCommentDto>();
}

<div class="tab-pane fade" id="tab-pane-3">
    <div class="row">

        <div class="col-md-6">
            <h4 class="mb-4">
                @activeComments.Count Reviews
            </h4>

            @foreach (var item in activeComments)
            {
                var avatarUrl =
                string.IsNullOrWhiteSpace(item.ImageUrl)
                ? "/images/userprofileavatar/avatargirl.png"
                : item.ImageUrl;

                <div class="media mb-4">

                    <img src="@avatarUrl"
                         alt="User avatar"
                         class="img-fluid mr-3 mt-1"
                         style="width:45px; height:50px; object-fit:cover; border-radius:50%;" />

                    <div class="media-body">

                        <h6>
                            @item.NameSurname

                            <small>
                                -
                                <i>
                                    @item.CreatedDate.ToShortDateString()
                                </i>
                            </small>
                        </h6>

                        <div class="text-primary mb-2">

                            @for (int i = 1; i <= item.Rating; i++)
                            {
                                <i class="fas fa-star"></i>
                            }

                            @for (int i = item.Rating + 1; i <= 5; i++)
                            {
                                <i class="far fa-star"></i>
                            }

                        </div>

                        <p>@item.CommentDetail</p>

                    </div>
                </div>
            }
        </div>

        @await Html.PartialAsync(
        "~/Views/ProductList/AddComment.cshtml",
                new CreateCommentDto
                {
                    ProductId = ViewBag.pid
                })

    </div>
</div>
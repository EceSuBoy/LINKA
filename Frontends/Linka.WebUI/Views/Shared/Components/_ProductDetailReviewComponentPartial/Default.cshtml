@using Linka.DtoLayer.CommentDtos

@model List<ResultCommentDto>

@{
    var activeComments =
        Model?
            .Where(x => x.Status == true)
            .ToList()
        ?? new List<ResultCommentDto>();
}

<style>
    .linka-review-card {
        position: relative;
        padding: 14px;
        border: 1px solid transparent;
        border-radius: 8px;
        transition: 0.2s ease;
    }

        .linka-review-card:hover {
            border-color: #ffd333;
            background-color: #fffdf5;
            box-shadow: 0 6px 16px rgba(0, 0, 0, 0.06);
        }

    .linka-review-message-button {
        position: absolute;
        top: 10px;
        right: 10px;
        display: none;
    }

    .linka-review-card:hover .linka-review-message-button {
        display: block;
    }
</style>

<div class="tab-pane fade" id="tab-pane-3">
    <div class="row">

        <div class="col-md-6">
            <h4 class="mb-4">
                @activeComments.Count Reviews
            </h4>

            @foreach (var item in activeComments)
            {
                var avatarUrl =
                string.IsNullOrWhiteSpace(item.ImageUrl)
                ? "/images/userprofileavatar/avatargirl.png"
                : item.ImageUrl;

                <div class="media mb-4 linka-review-card">

                    @if (User.Identity?.IsAuthenticated == true &&
                                    !string.IsNullOrWhiteSpace(item.UserId) &&
                                    item.UserId != ViewBag.CurrentUserId)
                    {
                        <form asp-area="User"
                              asp-controller="Message"
                              asp-action="StartConversation"
                              method="post"
                              class="linka-review-message-button">

                            @Html.AntiForgeryToken()

                            <input type="hidden"
                                   name="receiverUserId"
                                   value="@item.UserId" />

                            <input type="hidden"
                                   name="productId"
                                   value="@item.ProductId" />

                            <input type="hidden"
                                   name="commentId"
                                   value="@item.UserCommentId" />

                            <button type="submit"
                                    class="btn btn-sm btn-primary">

                                <i class="fa fa-envelope mr-1"></i>
                                Send Message

                            </button>

                        </form>
                    }

                    <img src="@avatarUrl"
                         alt="User avatar"
                         class="img-fluid mr-3 mt-1"
                         style="width:45px; height:50px; object-fit:cover; border-radius:50%;" />

                    <div class="media-body">

                        <h6>
                            @item.NameSurname

                            <small>
                                -
                                <i>
                                    @item.CreatedDate.ToShortDateString()
                                </i>
                            </small>
                        </h6>

                        <div class="text-primary mb-2">

                            @for (int i = 1; i <= item.Rating; i++)
                            {
                                <i class="fas fa-star"></i>
                            }

                            @for (int i = item.Rating + 1; i <= 5; i++)
                            {
                                <i class="far fa-star"></i>
                            }

                        </div>

                        <p>@item.CommentDetail</p>

                    </div>
                </div>
            }
        </div>

        @await Html.PartialAsync(
        "~/Views/ProductList/AddComment.cshtml",
                new CreateCommentDto
                {
                    ProductId = ViewBag.pid
                })

    </div>
</div>
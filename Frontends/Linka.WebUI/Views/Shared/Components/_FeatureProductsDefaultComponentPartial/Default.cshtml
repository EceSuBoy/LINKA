@using System.Globalization
@model List<Linka.WebUI.Models.FeaturedProductViewModel>

@{
    var culture = new CultureInfo("tr-TR");
}

<style>
    .product-card-fixed {
        height: 430px;
        display: flex;
        flex-direction: column;
    }

    .product-img-fixed {
        width: 100%;
        height: 250px;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        padding: 15px;
        background-color: #ffffff;
    }

        .product-img-fixed img {
            width: 100%;
            height: 100%;
            object-fit: contain;
            object-position: center;
        }

    .product-content-fixed {
        flex: 1;
        min-height: 170px;
        display: flex;
        flex-direction: column;
        justify-content: center;
    }

    .product-name-fixed {
        display: block;
        max-width: 90%;
        margin: 0 auto;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .product-price-row {
        min-height: 35px;
        flex-wrap: wrap;
    }

        .product-price-row h5 {
            margin-bottom: 0;
        }

    .product-stars-fixed {
        min-height: 24px;
    }

    .product-rating-value {
        margin-left: 5px;
        color: #6c757d;
        font-size: 12px;
    }
</style>

<div class="container-fluid pt-5 pb-3">

    <h2 class="section-title position-relative text-uppercase mx-xl-5 mb-4">
        <span class="bg-secondary pr-3">
            Featured Products
        </span>
    </h2>

    <div class="row px-xl-5">

        @foreach (var item in Model)
        {
            var roundedRating =
            Math.Round(
            item.AverageRating * 2,
            MidpointRounding.AwayFromZero) / 2;

            <div class="col-lg-3 col-md-4 col-sm-6 pb-1">

                <div class="product-item bg-light mb-4 product-card-fixed">

                    <div class="product-img position-relative overflow-hidden product-img-fixed">

                        <img src="@item.ProductImageUrl"
                             alt="@item.ProductName" />

                        @if (item.HasDiscount)
                        {
                            <span class="badge badge-danger position-absolute"
                                  style="top:12px; left:12px; padding:7px 9px; font-size:12px;">
                                -%@item.DiscountRate.ToString("0.##")
                            </span>
                        }

                        <div class="product-action">

                            <a class="btn btn-outline-dark btn-square"
                               href="/ShoppingCart/AddBasketItem/@item.ProductId">

                                <i class="fa fa-shopping-cart"></i>

                            </a>

                            <a class="btn btn-outline-dark btn-square"
                               href="">

                                <i class="far fa-heart"></i>

                            </a>

                            <a class="btn btn-outline-dark btn-square"
                               href="">

                                <i class="fa fa-sync-alt"></i>

                            </a>

                            <a class="btn btn-outline-dark btn-square"
                               href="/ProductList/ProductDetail/@item.ProductId">

                                <i class="fa fa-search"></i>

                            </a>

                        </div>

                    </div>

                    <div class="text-center py-4 product-content-fixed">

                        <a class="h6 text-decoration-none text-truncate product-name-fixed"
                           href="/ProductList/ProductDetail/@item.ProductId">

                            @item.ProductName

                        </a>
                        <div class="d-flex align-items-center justify-content-center mt-2 product-price-row">

                            @if (item.HasDiscount)
                            {
                                <h5>
                                    @item.DiscountedPrice.ToString("N2", culture) ₺
                                </h5>

                                <h6 class="text-muted ml-2">
                                    <del>
                                        @item.ProductPrice.ToString("N2", culture) ₺
                                    </del>
                                </h6>
                            }
                            else
                            {
                                <h5>
                                    @item.ProductPrice.ToString("N2", culture) ₺
                                </h5>
                            }

                        </div>

                        <div class="d-flex align-items-center justify-content-center mb-1 product-stars-fixed">

                            @for (int star = 1; star <= 5; star++)
                            {
                                if (roundedRating >= star)
                                {
                                    <small class="fas fa-star text-primary mr-1"></small>
                                }
                                else if (roundedRating >= star - 0.5)
                                {
                                    <small class="fas fa-star-half-alt text-primary mr-1"></small>
                                }
                                else
                                {
                                    <small class="far fa-star text-primary mr-1"></small>
                                }
                            }

                            <small>
                                (@item.CommentCount)
                            </small>

                            @if (item.CommentCount > 0)
                            {
                                <small class="product-rating-value">
                                    @item.AverageRating.ToString("0.0")
                                </small>
                            }

                        </div>

                    </div>

                </div>

            </div>
        }

    </div>

</div>
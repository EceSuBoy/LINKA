@using System.Globalization
@model Linka.WebUI.Models.OrderSummaryViewModel

@{
    var culture =
        new CultureInfo("tr-TR");
}

<style>
    .order-summary-card {
        border: 1px solid #edf0f4;
        border-radius: 8px;
        background-color: #ffffff;
        box-shadow: 0 7px 22px rgba(33, 48, 77, 0.06);
        overflow: hidden;
    }

    .order-summary-header {
        padding: 18px 20px;
        border-bottom: 1px solid #edf0f4;
        background-color: #ffffff;
    }

        .order-summary-header h6 {
            margin-bottom: 0;
            font-size: 17px;
            font-weight: 700;
            color: #2f3a4a;
        }

    .order-summary-product {
        display: flex;
        gap: 10px;
        padding: 14px 20px;
        border-bottom: 1px solid #edf0f4;
    }

    .order-summary-product-img {
        width: 52px;
        height: 52px;
        flex-shrink: 0;
        padding: 4px;
        border: 1px solid #edf0f4;
        border-radius: 6px;
        background-color: #ffffff;
        object-fit: contain;
    }

    .order-summary-product-info {
        flex: 1;
        min-width: 0;
    }

    .order-summary-product-name {
        display: block;
        margin-bottom: 3px;
        overflow: hidden;
        color: #2f3a4a;
        font-size: 14px;
        font-weight: 700;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .order-summary-product-meta {
        color: #7c8798;
        font-size: 12px;
    }

    .order-summary-product-total {
        color: #2f3a4a;
        font-size: 14px;
        font-weight: 700;
        white-space: nowrap;
    }

    .order-summary-breakdown {
        padding: 18px 20px 8px;
    }

    .order-summary-row {
        display: flex;
        justify-content: space-between;
        gap: 15px;
        margin-bottom: 11px;
        color: #5c6675;
        font-size: 14px;
    }

        .order-summary-row strong {
            color: #2f3a4a;
            font-weight: 600;
        }

    .order-summary-discount {
        color: #24a148 !important;
    }

    .order-summary-grand-total {
        display: flex;
        justify-content: space-between;
        gap: 15px;
        padding: 17px 20px;
        border-top: 1px solid #edf0f4;
        background-color: #f9fafc;
        color: #2f3a4a;
        font-size: 18px;
        font-weight: 800;
    }

    .order-summary-coupon {
        display: inline-block;
        margin-top: 2px;
        padding: 4px 8px;
        border-radius: 4px;
        background-color: #e8f7ed;
        color: #218739;
        font-size: 12px;
        font-weight: 700;
    }

    .order-summary-empty {
        padding: 22px 20px;
        color: #7c8798;
        font-size: 14px;
        text-align: center;
    }
</style>

<div class="order-summary-card">

    <div class="order-summary-header">
        <h6>
            <i class="fa fa-shopping-bag mr-2 text-primary"></i>
            Your Order
        </h6>
    </div>

    @if (Model.BasketItems.Any())
    {
        @foreach (var item in Model.BasketItems)
        {
            var lineTotal =
            item.Price *
            item.Quantity;

            <div class="order-summary-product">

                <img src="@item.ProductImageUrl"
                     alt="@item.ProductName"
                     class="order-summary-product-img" />

                <div class="order-summary-product-info">

                    <span class="order-summary-product-name">
                        @item.ProductName
                    </span>

                    <span class="order-summary-product-meta">
                        @item.Price.ToString("N2", culture) ₺
                        ×
                        @item.Quantity
                    </span>

                </div>

                <span class="order-summary-product-total">
                    @lineTotal.ToString("N2", culture) ₺
                </span>

            </div>
        }

        <div class="order-summary-breakdown">

            <div class="order-summary-row">
                <span>Subtotal</span>
                <strong>
                    @Model.SubTotal.ToString("N2", culture) ₺
                </strong>
            </div>

            @if (Model.HasDiscount)
            {
                <div class="order-summary-row">

                    <span>
                        Coupon Discount
                        <span class="order-summary-coupon">
                            @Model.DiscountCode
                        </span>
                    </span>

                    <strong class="order-summary-discount">
                        -@Model.DiscountAmount.ToString("N2", culture) ₺
                    </strong>

                </div>

                <div class="order-summary-row">
                    <span>Discounted Subtotal</span>
                    <strong>
                        @Model.DiscountedSubTotal.ToString("N2", culture) ₺
                    </strong>
                </div>
            }

            <div class="order-summary-row">

                <span>
                    VAT
                    (%@Model.VatRate.ToString("0"))
                </span>

                <strong>
                    @Model.VatAmount.ToString("N2", culture) ₺
                </strong>

            </div>

            <div class="order-summary-row">

                <span>Shipping</span>

                @if (Model.HasFreeShipping)
                {
                    <strong class="order-summary-discount">
                        Free
                    </strong>
                }
                else
                {
                    <strong>
                        @Model.ShippingFee.ToString("N2", culture) ₺
                    </strong>
                }

            </div>

        </div>

        <div class="order-summary-grand-total">

            <span>
                Grand Total
            </span>

            <span>
                @Model.GrandTotal.ToString("N2", culture) ₺
            </span>

        </div>
    }
    else
    {
        <div class="order-summary-empty">
            Your cart is empty.
        </div>
    }

</div>
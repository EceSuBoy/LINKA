@model Linka.WebUI.Models.SimpleWeatherViewModel

@{
    var temperatureCelsius = (Model.Temperature - 32) * 5 / 9;
}

<style>
    .header-weather-card {
        position: relative;
        width: 100%;
        height: 68px;
        overflow: hidden;
        border-radius: 12px;
        color: #ffffff;
        background-image: linear-gradient( 135deg, rgba(21, 72, 112, 0.78), rgba(47, 134, 191, 0.38) ), url('@Model.BackgroundImage');
        background-size: cover;
        background-position: center;
        box-shadow: 0 5px 14px rgba(47, 134, 191, 0.20);
    }

    .header-weather-content {
        position: relative;
        height: 100%;
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 10px 13px;
        z-index: 2;
    }

    .header-weather-city {
        display: block;
        margin-bottom: 2px;
        font-size: 16px;
        line-height: 1.1;
        font-weight: 700;
    }

    .header-weather-status {
        display: block;
        font-size: 12px;
        opacity: 0.92;
    }

    .header-weather-temperature {
        font-size: 25px;
        line-height: 1;
        font-weight: 800;
        white-space: nowrap;
    }
</style>

<div class="header-weather-card">

    <div class="header-weather-content">

        <div>
            <span class="header-weather-city">
                Istanbul
            </span>

            <span class="header-weather-status">
                Sunny
            </span>
        </div>

        <div class="header-weather-temperature">
            @Math.Round(temperatureCelsius)°C
        </div>

    </div>

</div>
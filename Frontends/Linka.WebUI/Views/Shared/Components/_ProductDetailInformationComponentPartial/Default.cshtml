@model UpdateProductDetailDto

<div class="tab-pane fade" id="tab-pane-2">
    <h4 class="mb-3">Additional Information</h4>
    @if (Model != null && !string.IsNullOrWhiteSpace(Model.ProductDescription))
    {
        <p>@Model.ProductInfo</p>
    }
    else
    {
        <p class="text-muted">There is no information for this product yet.</p>
    }
</div>

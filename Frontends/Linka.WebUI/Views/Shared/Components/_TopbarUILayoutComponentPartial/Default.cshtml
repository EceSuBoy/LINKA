<div class="container-fluid">
    <div class="row align-items-center bg-light py-3 px-xl-5 d-none d-lg-flex">

        <!-- Logo -->
        <div class="col-lg-4">
            <a asp-controller="Default"
               asp-action="Index"
               class="text-decoration-none">
                <span class="h1 text-uppercase text-primary bg-dark px-2">LINK</span>
                <span class="h1 text-uppercase text-dark bg-primary px-2 ml-n1">A</span>
            </a>
        </div>

        <!-- Search Bar -->
        <div class="col-lg-4 col-6 text-left">
            <form action="">
                <div class="input-group">
                    <input type="text"
                           class="form-control"
                           placeholder="Search for products">

                    <div class="input-group-append">
                        <span class="input-group-text bg-transparent text-primary">
                            <i class="fa fa-search"></i>
                        </span>
                    </div>
                </div>
            </form>
        </div>

        <!-- Weather + Customer Service -->
        <div class="col-lg-4 col-6">

            <div class="header-right-section">

                <div class="header-weather-wrapper">
                    <div class="header-weather-card">
                        <div class="header-weather-content">
                            <div>
                                <span class="header-weather-city">Istanbul</span>
                                <span class="header-weather-status">Sunny</span>
                            </div>

                            <div class="header-weather-temperature">
                                23°C
                            </div>
                        </div>
                    </div>
                    @* bundan oncesi silenecek bu divin icinde *@
                    @* @await Component.InvokeAsync("_WeatherDefaultComponentPartial") *@
                </div>

                <div>
                    @await Component.InvokeAsync("_UserLoginDefaultComponentPartial")
                </div>

            </div>

        </div>

    </div>
</div>

<style>
    .header-right-section {
        display: flex;
        justify-content: flex-end;
        align-items: center;
        gap: 20px;
    }

    .header-weather-wrapper {
        width: 190px;
        flex-shrink: 0;
    }

    .customer-service-wrapper {
        min-width: 170px;
        text-align: right;
        white-space: nowrap;
    }
</style>
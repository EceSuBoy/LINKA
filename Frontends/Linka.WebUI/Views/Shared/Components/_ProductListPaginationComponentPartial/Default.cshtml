@model Linka.WebUI.Models.ProductListPaginationViewModel

@if (Model.TotalPages > 1)
{
    <div class="col-12">

        <nav>

            <ul class="pagination justify-content-center">

                <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">

                    @if (Model.CurrentPage == 1)
                    {
                        <span class="page-link">
                            Previous
                        </span>
                    }
                    else
                    {
                        <a asp-controller="ProductList"
                           asp-action="Index"
                           asp-route-id="@Model.CategoryId"
                           asp-route-minPrice="@Model.MinPrice"
                           asp-route-maxPrice="@Model.MaxPrice"
                           asp-route-sort="@Model.Sort"
                           asp-route-pageSize="@Model.PageSize"
                           asp-route-page="@(Model.CurrentPage - 1)"
                           class="page-link">

                            Previous

                        </a>
                    }

                </li>

                @for (int pageNumber = 1;
                            pageNumber <= Model.TotalPages;
                            pageNumber++)
                {
                    <li class="page-item @(pageNumber == Model.CurrentPage ? "active" : "")">

                        <a asp-controller="ProductList"
                           asp-action="Index"
                           asp-route-id="@Model.CategoryId"
                           asp-route-minPrice="@Model.MinPrice"
                           asp-route-maxPrice="@Model.MaxPrice"
                           asp-route-sort="@Model.Sort"
                           asp-route-pageSize="@Model.PageSize"
                           asp-route-page="@pageNumber"
                           class="page-link">

                            @pageNumber

                        </a>

                    </li>
                }

                <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">

                    @if (Model.CurrentPage == Model.TotalPages)
                    {
                        <span class="page-link">
                            Next
                        </span>
                    }
                    else
                    {
                        <a asp-controller="ProductList"
                           asp-action="Index"
                           asp-route-id="@Model.CategoryId"
                           asp-route-minPrice="@Model.MinPrice"
                           asp-route-maxPrice="@Model.MaxPrice"
                           asp-route-sort="@Model.Sort"
                           asp-route-pageSize="@Model.PageSize"
                           asp-route-page="@(Model.CurrentPage + 1)"
                           class="page-link">

                            Next

                        </a>
                    }

                </li>

            </ul>

        </nav>

    </div>
}
@*
    Linka Assistant — floating chatbot widget.
    Self-contained: it pulls in its own CSS and JS, so the only thing you add
    to a layout is a single line:  <partial name="_ChatbotWidget" />
*@

<link rel="stylesheet" href="~/css/chatbot.css" asp-append-version="true" />

<div id="linka-chat" class="linka-chat">

    <!-- Floating launcher button -->
    <button id="linka-chat-toggle" class="linka-chat-toggle" type="button" aria-label="Open chat assistant">
        <svg class="linka-chat-ico-open" viewBox="0 0 24 24" width="26" height="26" aria-hidden="true">
            <path fill="currentColor" d="M12 3C6.5 3 2 6.7 2 11.2c0 2.4 1.3 4.6 3.3 6.1-.1 1.1-.6 2.3-1.5 3.3 1.6-.2 3.1-.8 4.3-1.7 1.2.4 2.5.6 3.9.6 5.5 0 10-3.7 10-8.3S17.5 3 12 3z"/>
        </svg>
        <svg class="linka-chat-ico-close" viewBox="0 0 24 24" width="24" height="24" aria-hidden="true">
            <path fill="currentColor" d="M18.3 5.7 12 12l6.3 6.3-1.4 1.4L10.6 13.4 4.3 19.7 2.9 18.3 9.2 12 2.9 5.7l1.4-1.4L10.6 10.6 16.9 4.3z"/>
        </svg>
    </button>

    <!-- Chat panel -->
    <div id="linka-chat-panel" class="linka-chat-panel" role="dialog" aria-label="Linka Assistant">

        <div class="linka-chat-header">
            <div class="linka-chat-header-avatar">L</div>
            <div class="linka-chat-header-text">
                <strong>Linka Assistant</strong>
                <span>Find products instantly</span>
            </div>
            <button id="linka-chat-min" class="linka-chat-min" type="button" aria-label="Close">&times;</button>
        </div>

        <div id="linka-chat-body" class="linka-chat-body"></div>

        <div class="linka-chat-input">
            <input id="linka-chat-text" type="text" autocomplete="off"
                   placeholder="Search a product, e.g. &quot;laptop&quot;..." />
            <button id="linka-chat-send" type="button" aria-label="Send">
                <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
                    <path fill="currentColor" d="M3 11.5 21 3l-8.5 18-2.4-7.1L3 11.5z"/>
                </svg>
            </button>
        </div>
    </div>
</div>

<script src="~/js/chatbot.js" asp-append-version="true"></script>

@model Linka.WebUI.Models.PaymentViewModel

@{
    ViewData["Title"] = "Secure Payment";
    Layout = "~/Views/UILayout/_UILayout.cshtml";

    var currentYear =
        DateTime.Now.Year;
}

<style>
    .linka-payment-page {
        padding-bottom: 50px;
    }

    .linka-payment-title {
        margin-bottom: 7px;
        color: #2f3a4a;
        font-size: 27px;
        font-weight: 800;
    }

    .linka-payment-subtitle {
        margin-bottom: 0;
        color: #7c8798;
        font-size: 14px;
    }

    .linka-payment-form-card {
        padding: 26px;
        border: 1px solid #edf0f4;
        border-radius: 9px;
        background-color: #ffffff;
        box-shadow: 0 7px 22px rgba(33, 48, 77, 0.06);
    }

    .linka-payment-section-heading {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        margin-bottom: 21px;
        padding-bottom: 14px;
        border-bottom: 1px solid #edf0f4;
    }

    .linka-payment-section-title {
        margin-bottom: 0;
        color: #2f3a4a;
        font-size: 18px;
        font-weight: 800;
    }

    .linka-secure-badge {
        padding: 5px 9px;
        border-radius: 5px;
        background-color: #e8f7ed;
        color: #218739;
        font-size: 11px;
        font-weight: 700;
    }

    .linka-credit-card-preview {
        position: relative;
        max-width: 430px;
        min-height: 235px;
        margin: 0 auto 28px;
        padding: 25px;
        overflow: hidden;
        border-radius: 16px;
        background: linear-gradient(135deg, #27364f, #111827);
        box-shadow: 0 17px 34px rgba(20, 31, 52, 0.24);
        color: #ffffff;
    }

        .linka-credit-card-preview::after {
            position: absolute;
            width: 210px;
            height: 210px;
            right: -78px;
            top: -73px;
            border-radius: 50%;
            background-color: rgba(255, 211, 51, 0.14);
            content: "";
        }

        .linka-credit-card-preview::before {
            position: absolute;
            width: 170px;
            height: 170px;
            right: -50px;
            bottom: -115px;
            border-radius: 50%;
            background-color: rgba(255, 255, 255, 0.06);
            content: "";
        }

    .linka-credit-card-top {
        position: relative;
        z-index: 1;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .linka-credit-card-chip {
        width: 46px;
        height: 34px;
        border-radius: 7px;
        background: linear-gradient(135deg, #f1d581, #b99232);
    }

    .linka-credit-card-brand {
        color: #ffd333;
        font-size: 22px;
        font-style: italic;
        font-weight: 900;
        letter-spacing: 1px;
    }

    .linka-credit-card-number {
        position: relative;
        z-index: 1;
        margin-top: 44px;
        color: #ffffff;
        font-size: 23px;
        font-weight: 700;
        letter-spacing: 3px;
    }

    .linka-credit-card-bottom {
        position: relative;
        z-index: 1;
        display: flex;
        justify-content: space-between;
        gap: 20px;
        margin-top: 35px;
    }

    .linka-credit-card-label {
        display: block;
        margin-bottom: 4px;
        color: rgba(255, 255, 255, 0.62);
        font-size: 10px;
        font-weight: 700;
        letter-spacing: 1px;
        text-transform: uppercase;
    }

    .linka-credit-card-value {
        display: block;
        max-width: 255px;
        overflow: hidden;
        color: #ffffff;
        font-size: 14px;
        font-weight: 700;
        letter-spacing: 0.5px;
        text-overflow: ellipsis;
        text-transform: uppercase;
        white-space: nowrap;
    }

    .linka-payment-label {
        margin-bottom: 7px;
        color: #536071;
        font-size: 13px;
        font-weight: 700;
    }

    .linka-payment-control {
        min-height: 45px;
        border: 1px solid #dfe4eb;
        border-radius: 5px;
        background-color: #ffffff;
    }

        .linka-payment-control:focus {
            border-color: #ffd333;
            box-shadow: 0 0 0 0.15rem rgba(255, 211, 51, 0.16);
        }

    .linka-demo-payment-note {
        margin-top: 18px;
        padding: 13px 15px;
        border-radius: 6px;
        background-color: #fffbed;
        color: #7d6814;
        font-size: 12px;
        line-height: 1.6;
    }

    .linka-payment-submit {
        margin-top: 19px;
        padding: 13px;
        font-weight: 800;
    }

    .linka-payment-validation {
        margin-top: 5px;
        font-size: 12px;
    }
</style>

<div class="container-fluid linka-payment-page">

    <div class="row px-xl-5 mb-4">

        <div class="col-12">

            <h2 class="linka-payment-title">
                Secure Payment
            </h2>

            <p class="linka-payment-subtitle">
                Complete the simulated payment to finish your order.
            </p>

        </div>

    </div>

    <div class="row px-xl-5">

        <div class="col-lg-8 mb-4">

            <div class="linka-payment-form-card">

                <div class="linka-payment-section-heading">

                    <h5 class="linka-payment-section-title">
                        <i class="fa fa-credit-card mr-2 text-primary"></i>
                        Card Details
                    </h5>

                </div>

                <div class="linka-credit-card-preview">

                    <div class="linka-credit-card-top">

                        <span class="linka-credit-card-chip">
                        </span>

                        <span class="linka-credit-card-brand">
                            LINKA
                        </span>

                    </div>

                    <div class="linka-credit-card-number"
                         id="card-number-preview">

                        #### #### #### ####

                    </div>

                    <div class="linka-credit-card-bottom">

                        <div>

                            <span class="linka-credit-card-label">
                                Card Holder
                            </span>

                            <span class="linka-credit-card-value"
                                  id="card-holder-preview">

                                FULL NAME

                            </span>

                        </div>

                        <div>

                            <span class="linka-credit-card-label">
                                Expires
                            </span>

                            <span class="linka-credit-card-value">

                                <span id="expiration-month-preview">
                                    MM
                                </span>

                                /

                                <span id="expiration-year-preview">
                                    YY
                                </span>

                            </span>

                        </div>

                    </div>

                </div>

                <form asp-controller="Payment"
                      asp-action="Index"
                      method="post">

                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly"
                         class="alert alert-danger">
                    </div>

                    <div class="form-group">

                        <label class="linka-payment-label">
                            Card Number
                        </label>

                        <input asp-for="CardNumber"
                               id="card-number-input"
                               class="form-control linka-payment-control"
                               type="text"
                               maxlength="19"
                               inputmode="numeric"
                               autocomplete="cc-number"
                               placeholder="4242 4242 4242 4242" />

                        <span asp-validation-for="CardNumber"
                              class="text-danger linka-payment-validation">
                        </span>

                    </div>

                    <div class="form-group">

                        <label class="linka-payment-label">
                            Card Holder Name
                        </label>

                        <input asp-for="CardHolderName"
                               id="card-holder-input"
                               class="form-control linka-payment-control"
                               type="text"
                               autocomplete="cc-name"
                               placeholder="Name Surname" />

                        <span asp-validation-for="CardHolderName"
                              class="text-danger linka-payment-validation">
                        </span>

                    </div>

                    <div class="row">

                        <div class="col-md-4 form-group">

                            <label class="linka-payment-label">
                                Expiration Month
                            </label>

                            <select asp-for="ExpirationMonth"
                                    id="expiration-month-input"
                                    class="form-control linka-payment-control"
                                    autocomplete="cc-exp-month">

                                <option value="">
                                    Month
                                </option>

                                @for (var month = 1;
                                                                month <= 12;
                                                                month++)
                                {
                                    <option value="@month">
                                        @month.ToString("00")
                                    </option>
                                }

                            </select>

                            <span asp-validation-for="ExpirationMonth"
                                  class="text-danger linka-payment-validation">
                            </span>

                        </div>

                        <div class="col-md-4 form-group">

                            <label class="linka-payment-label">
                                Expiration Year
                            </label>

                            <select asp-for="ExpirationYear"
                                    id="expiration-year-input"
                                    class="form-control linka-payment-control"
                                    autocomplete="cc-exp-year">

                                <option value="">
                                    Year
                                </option>

                                @for (var year =
                                                                currentYear;
                                                                year <=
                                                                currentYear + 10;
                                                                year++)
                                {
                                    <option value="@year">
                                        @year
                                    </option>
                                }

                            </select>

                            <span asp-validation-for="ExpirationYear"
                                  class="text-danger linka-payment-validation">
                            </span>

                        </div>

                        <div class="col-md-4 form-group">

                            <label class="linka-payment-label">
                                CVV
                            </label>

                            <input asp-for="Cvv"
                                   class="form-control linka-payment-control"
                                   type="password"
                                   maxlength="4"
                                   inputmode="numeric"
                                   autocomplete="cc-csc"
                                   placeholder="123" />

                            <span asp-validation-for="Cvv"
                                  class="text-danger linka-payment-validation">
                            </span>

                        </div>

                    </div>

                    <button type="submit"
                            class="btn btn-block btn-primary linka-payment-submit">

                        Complete Payment

                        <i class="fa fa-lock ml-2"></i>

                    </button>

                </form>

            </div>

        </div>

        <div class="col-lg-4">

            @await Component.InvokeAsync(
            "_OrderSummaryComponentPartial")

        </div>

    </div>

</div>

<script>
    document.addEventListener(
        "DOMContentLoaded",
        function () {
            const cardNumberInput =
                document.getElementById(
                    "card-number-input");

            const cardHolderInput =
                document.getElementById(
                    "card-holder-input");

            const expirationMonthInput =
                document.getElementById(
                    "expiration-month-input");

            const expirationYearInput =
                document.getElementById(
                    "expiration-year-input");

            const cardNumberPreview =
                document.getElementById(
                    "card-number-preview");

            const cardHolderPreview =
                document.getElementById(
                    "card-holder-preview");

            const expirationMonthPreview =
                document.getElementById(
                    "expiration-month-preview");

            const expirationYearPreview =
                document.getElementById(
                    "expiration-year-preview");

            cardNumberInput.addEventListener(
                "input",
                function () {
                    const digits =
                        this.value
                            .replace(/\D/g, "")
                            .substring(0, 16);

                    const formattedValue =
                        digits.match(/.{1,4}/g)
                            ?.join(" ") ?? "";

                    this.value =
                        formattedValue;

                    cardNumberPreview.textContent =
                        formattedValue ||
                        "#### #### #### ####";
                });

            cardHolderInput.addEventListener(
                "input",
                function () {
                    cardHolderPreview.textContent =
                        this.value.trim() ||
                        "FULL NAME";
                });

            expirationMonthInput.addEventListener(
                "change",
                function () {
                    expirationMonthPreview.textContent =
                        this.value
                            ? this.value.padStart(
                                2,
                                "0")
                            : "MM";
                });

            expirationYearInput.addEventListener(
                "change",
                function () {
                    expirationYearPreview.textContent =
                        this.value
                            ? this.value.slice(-2)
                            : "YY";
                });
        });
</script>
@{
    ViewData["Title"] = "ProductDetail";
    Layout = "~/Views/UILayout/_UILayout.cshtml";
}

@if (TempData["BasketError"] != null)
{
    <div class="row px-xl-5">
        <div class="col-12">
            <div class="alert alert-danger">
                @TempData["BasketError"]
            </div>
        </div>
    </div>
}

<div class="container-fluid pb-5">
    <div class="row px-xl-5">

        @await Component.InvokeAsync("_ProductDetailImageSliderComponentPartial", new { id = ViewBag.x })

        @await Component.InvokeAsync(
        "_ProductDetailFeatureComponentPartial",
                new
                {
                    id = (string)ViewBag.x,
                    commentCount =
                (int)ViewBag.ReviewCount,
                    averageRating =
                (double)ViewBag.AverageRating
                })

    </div>
    <div class="row px-xl-5">
        <div class="col">
            <div class="bg-light p-30">
                <div class="nav nav-tabs mb-4">
                    <a class="nav-item nav-link text-dark active" data-toggle="tab" href="#tab-pane-1">Description</a>
                    <a class="nav-item nav-link text-dark" data-toggle="tab" href="#tab-pane-2">Information</a>
                    <a class="nav-item nav-link text-dark"
                       data-toggle="tab"
                       href="#tab-pane-3">
                        Reviews (@ViewBag.ReviewCount)
                    </a>
                </div>
                <div class="tab-content">
                    @await Component.InvokeAsync(
                                        "_ProductDetailDescriptionComponentPartial",
                                        new { id = ViewBag.x })

                    @await Component.InvokeAsync(
                                        "_ProductDetailInformationComponentPartial",
                                        new { id = ViewBag.x })

                    @await Component.InvokeAsync(
                                        "_ProductDetailReviewComponentPartial",
                                        new { id = ViewBag.x })

                </div>
            </div>
        </div>
    </div>
</div>

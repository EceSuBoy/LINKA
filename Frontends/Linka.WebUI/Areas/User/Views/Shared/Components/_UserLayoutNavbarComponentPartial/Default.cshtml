@model Linka.WebUI.Models.UserLayoutNavbarViewModel

<style>
    .linka-compact-navbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 24px;
        min-height: 78px;
        padding: 14px 28px;
        border-bottom: 1px solid #e5eaf2;
        background-color: #ffffff;
        box-shadow: 0 4px 13px rgba(30, 55, 95, 0.05);
    }

    .linka-navbar-brand-area {
        display: flex;
        align-items: center;
        gap: 14px;
        flex-shrink: 0;
    }

    .linka-sidebar-toggle {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 39px;
        height: 39px;
        border: none;
        border-radius: 8px;
        color: #3156ba;
        background-color: #eef3ff;
        font-size: 22px;
        cursor: pointer;
        transition: 0.2s ease;
    }

        .linka-sidebar-toggle:hover {
            color: #ffffff;
            background-color: #3156ba;
        }

    .linka-navbar-logo {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        height: 44px;
        padding: 0 15px;
        border-radius: 5px;
        color: #26374b !important;
        background-color: #ffd333;
        font-size: 20px;
        font-weight: 800;
        letter-spacing: 2px;
        text-decoration: none !important;
        transition: 0.2s ease;
    }

        .linka-navbar-logo:hover {
            background-color: #f4c522;
            transform: translateY(-1px);
        }

    .linka-navbar-search-area {
        flex: 1;
        max-width: 760px;
    }

    .linka-navbar-search-wrapper {
        position: relative;
        width: 100%;
    }

    .linka-navbar-search-input {
        width: 100%;
        height: 43px;
        padding: 0 46px 0 15px;
        border: 1px solid #dfe6f0;
        border-radius: 8px;
        color: #34475d;
        background-color: #f9fbff;
        font-size: 14px;
        outline: none;
        transition: 0.2s ease;
    }

        .linka-navbar-search-input:focus {
            border-color: #3156ba;
            background-color: #ffffff;
            box-shadow: 0 0 0 3px rgba(49, 86, 186, 0.10);
        }

    .linka-navbar-search-icon {
        position: absolute;
        top: 50%;
        right: 16px;
        color: #3156ba;
        font-size: 19px;
        transform: translateY(-50%);
    }

    .linka-navbar-actions {
        display: flex;
        align-items: center;
        gap: 15px;
        flex-shrink: 0;
    }

    .linka-navbar-action-link {
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 39px;
        height: 39px;
        border-radius: 50%;
        color: #3156ba;
        background-color: #eef3ff;
        font-size: 19px;
        text-decoration: none !important;
        transition: 0.2s ease;
    }

        .linka-navbar-action-link:hover {
            color: #ffffff;
            background-color: #3156ba;
        }

    .linka-navbar-badge {
        position: absolute;
        top: -5px;
        right: -4px;
        display: flex;
        align-items: center;
        justify-content: center;
        min-width: 18px;
        height: 18px;
        padding: 0 5px;
        border-radius: 20px;
        color: #ffffff;
        background-color: #ff4f58;
        font-size: 10px;
        font-weight: 700;
    }

    .linka-navbar-profile-button {
        display: flex;
        align-items: center;
        gap: 10px;
        min-width: 157px;
        padding: 6px 9px;
        border: none;
        border-radius: 9px;
        color: #293b50;
        background-color: #f4f7fd;
        text-align: left;
        cursor: pointer;
        transition: 0.2s ease;
    }

        .linka-navbar-profile-button:hover,
        .linka-navbar-profile-button:focus {
            color: #293b50;
            background-color: #eaf0ff;
            box-shadow: none;
            outline: none;
        }

    .linka-navbar-avatar {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 37px;
        height: 37px;
        border-radius: 50%;
        color: #ffffff;
        background: linear-gradient(135deg, #3156ba, #6284e5);
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 0.5px;
        flex-shrink: 0;
    }

    .linka-navbar-profile-text {
        display: flex;
        flex-direction: column;
        overflow: hidden;
        max-width: 125px;
    }

    .linka-navbar-profile-name {
        overflow: hidden;
        color: #293b50;
        font-size: 13px;
        font-weight: 700;
        line-height: 1.2;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .linka-navbar-profile-role {
        color: #8998aa;
        font-size: 11px;
        line-height: 1.2;
    }

    .linka-navbar-dropdown {
        min-width: 225px;
        margin-top: 9px;
        padding: 7px 0;
        border: none;
        border-radius: 8px;
        box-shadow: 0 10px 24px rgba(28, 48, 78, 0.16);
    }

        .linka-navbar-dropdown .dropdown-item {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 10px 15px;
            color: #35495e;
            font-size: 14px;
        }

            .linka-navbar-dropdown .dropdown-item:hover {
                color: #3156ba;
                background-color: #eef3ff;
            }

        .linka-navbar-dropdown i {
            width: 17px;
            color: #3156ba;
            text-align: center;
        }

    @@media (max-width: 1100px) {
        .linka-navbar-search-area {
            max-width: 520px;
        }

        .linka-navbar-profile-role {
            display: none;
        }
    }
</style>

<nav class="linka-compact-navbar">

    <!-- Logo + Sidebar Button -->
    <div class="linka-navbar-brand-area">

        <button type="button"
                class="linka-sidebar-toggle"
                data-toggle="minimize"
                title="Toggle Menu">
            <i class="mdi mdi-menu"></i>
        </button>

        <a href="/Default/Index"
           class="linka-navbar-logo">
            LINKA
        </a>

    </div>

    <!-- Search -->
    <div class="linka-navbar-search-area">

        <div class="linka-navbar-search-wrapper">

            <input type="text"
                   class="linka-navbar-search-input"
                   placeholder="Search your orders, messages or cargo information..." />

            <i class="mdi mdi-magnify linka-navbar-search-icon"></i>

        </div>

    </div>

    <!-- Notifications + Profile -->
    <div class="linka-navbar-actions">

        <a href="/User/Message/Index"
           class="linka-navbar-action-link"
           title="Messages">

            <i class="mdi mdi-email-outline"></i>
            <span class="linka-navbar-badge">1</span>

        </a>

        <a href="/User/MyOrder/MyOrderList"
           class="linka-navbar-action-link"
           title="Orders">

            <i class="mdi mdi-cart-outline"></i>
            <span class="linka-navbar-badge">2</span>

        </a>

        <div class="dropdown">

            <button class="linka-navbar-profile-button dropdown-toggle"
                    type="button"
                    id="userProfileDropdown"
                    data-toggle="dropdown"
                    aria-haspopup="true"
                    aria-expanded="false">

                <span class="linka-navbar-avatar">
                    @Model.Initials
                </span>

                <span class="linka-navbar-profile-text">

                    <span class="linka-navbar-profile-name">
                        @Model.FullName
                    </span>

                    <span class="linka-navbar-profile-role">
                        LINKA Member
                    </span>

                </span>

            </button>

            <div class="dropdown-menu dropdown-menu-right linka-navbar-dropdown"
                 aria-labelledby="userProfileDropdown">

                <a href="/User/Profile"
                   class="dropdown-item">

                    <i class="mdi mdi-account-outline"></i>
                    <span>My Profile</span>

                </a>

                <a href="/User/Profile/ChangePassword"
                   class="dropdown-item">

                    <i class="mdi mdi-lock-outline"></i>
                    <span>Change Password</span>

                </a>

                <a href="/User/MyOrder/MyOrderList"
                   class="dropdown-item">

                    <i class="mdi mdi-shopping-outline"></i>
                    <span>My Orders</span>

                </a>

                <div class="dropdown-divider"></div>

                <form asp-area=""
                      asp-controller="Login"
                      asp-action="LogOut"
                      method="post"
                      class="m-0">

                    @Html.AntiForgeryToken()

                    <button type="submit"
                            class="dropdown-item border-0 bg-transparent">

                        <i class="mdi mdi-logout"></i>
                        <span>Log Out</span>

                    </button>
                </form>

            </div>

        </div>

    </div>

</nav>
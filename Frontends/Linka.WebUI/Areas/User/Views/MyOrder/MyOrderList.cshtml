@using Linka.DtoLayer.OrderDtos.OrderOrderingDtos
@model List<ResultOrderingByUserIdDto>

@{
    ViewData["Title"] = "My Orders";
    Layout = "~/Areas/User/Views/UserLayout/Index.cshtml";
    int count = 0;
}

<style>
    .table-striped tbody tr:nth-child(1) {
        background-color: #d1ecf1;
    }

    .table-striped tbody tr:nth-child(2) {
        background-color: #fff3cd;
    }

    .table-striped tbody tr:nth-child(3) {
        background-color: #f5c6cb;
    }

    .table-striped tbody tr:nth-child(4) {
        background-color: #c3e6cb;
    }

    .table-striped tbody tr:nth-child(5) {
        background-color: #bbdaff;
    }

    .table-striped tbody tr:nth-child(6) {
        background-color: #d6d8db;
    }

    .table-striped tbody tr:nth-child(7) {
        background-color: #e2e3e5;
    }
</style>

<div class="main-panel">
    <div class="content-wrapper">
        <div class="row">
            <div class="col-lg-12 grid-margin stretch-card">
                <div class="card">
                    <div class="card-body">

                        <h4 class="card-title">Order History</h4>
                        <p class="card-description">
                            You can view your previous orders below.
                        </p>

                        <div class="table-responsive">
                            <table class="table table-bordered table-striped">
                                <thead>
                                    <tr>
                                        <th>#</th>
                                        <th>Total Price</th>
                                        <th>Order Date</th>
                                        <th>Order Details</th>
                                    </tr>
                                </thead>

                                <tbody>
                                    @foreach (var item in Model)
                                    {
                                        count++;
                                        <tr>
                                            <th>@count</th>
                                            <td>@item.TotalPrice ₺</td>
                                            <td>@item.OrderDate.ToString("dd-MMM-yyyy")</td>
                                            <td>
                                                <a href="#" class="btn btn-warning">
                                                    Order Details
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
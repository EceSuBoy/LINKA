@using System.Globalization
@using Linka.DtoLayer.OrderDtos.OrderOrderingDtos
@model ResultOrderingDetailDto

@{
    ViewData["Title"] = "Order Detail";
    Layout = "~/Areas/User/Views/UserLayout/Index.cshtml";

    var culture =
        new CultureInfo("tr-TR");

    var displayOrderNumber =
        $"LNK-{Model.OrderDate:yyyyMMdd}-{Model.OrderingId:D6}";

    var status =
        string.IsNullOrWhiteSpace(Model.OrderStatus)
            ? "Paid"
            : Model.OrderStatus;

    var statusClass =
        status.ToLowerInvariant() switch
        {
            "preparing" => "status-preparing",
            "shipped" => "status-shipped",
            "delivered" => "status-delivered",
            "cancelled" => "status-cancelled",
            _ => "status-paid"
        };

    var productSubTotal =
        Model.OrderDetails.Sum(
            x => x.ProductTotalPrice);
}

<style>
    .linka-detail-page {
        padding: 22px;
    }

    .linka-detail-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 20px;
    }

    .linka-detail-title {
        margin-bottom: 5px;
        color: #2f3a4a;
        font-size: 24px;
        font-weight: 800;
    }

    .linka-detail-subtitle {
        margin-bottom: 0;
        color: #7c8798;
        font-size: 13px;
    }

    .linka-back-btn {
        padding: 8px 13px;
        border-radius: 6px;
        font-size: 13px;
        font-weight: 700;
    }

    .linka-detail-card {
        margin-bottom: 20px;
        border: 1px solid #edf0f4;
        border-radius: 10px;
        background-color: #ffffff;
        box-shadow: 0 7px 22px rgba(33, 48, 77, 0.06);
        overflow: hidden;
    }

    .linka-detail-card-header {
        padding: 18px 20px;
        border-bottom: 1px solid #edf0f4;
        background-color: #ffffff;
    }

    .linka-detail-card-title {
        margin-bottom: 0;
        color: #2f3a4a;
        font-size: 16px;
        font-weight: 800;
    }

    .linka-order-info-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 14px;
        padding: 20px;
    }

    .linka-order-info-item {
        padding: 14px;
        border-radius: 7px;
        background-color: #f8fafc;
    }

    .linka-order-info-label {
        display: block;
        margin-bottom: 5px;
        color: #8b96a7;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 0.4px;
        text-transform: uppercase;
    }

    .linka-order-info-value {
        display: block;
        color: #2f3a4a;
        font-size: 14px;
        font-weight: 800;
    }

    .linka-order-status {
        display: inline-block;
        padding: 6px 10px;
        border-radius: 20px;
        font-size: 11px;
        font-weight: 800;
    }

    .status-paid {
        background-color: #e8f7ed;
        color: #218739;
    }

    .status-preparing {
        background-color: #fff5d6;
        color: #a87700;
    }

    .status-shipped {
        background-color: #e7f1ff;
        color: #1d67b1;
    }

    .status-delivered {
        background-color: #e8f7ed;
        color: #218739;
    }

    .status-cancelled {
        background-color: #fdeaea;
        color: #c0392b;
    }

    .linka-product-table {
        margin-bottom: 0;
    }

        .linka-product-table th {
            border-top: none;
            color: #7c8798;
            font-size: 12px;
            font-weight: 700;
            letter-spacing: 0.35px;
            text-transform: uppercase;
        }

        .linka-product-table td {
            vertical-align: middle;
            color: #2f3a4a;
        }

    .linka-product-name {
        color: #2f3a4a;
        font-weight: 800;
    }

    .linka-detail-total-box {
        padding: 18px 20px;
        border-top: 1px solid #edf0f4;
        background-color: #f9fafc;
    }

    .linka-detail-total-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 8px;
        color: #677386;
        font-size: 14px;
    }

        .linka-detail-total-row:last-child {
            margin-bottom: 0;
        }

    .linka-detail-grand-total {
        color: #2f3a4a;
        font-size: 18px;
        font-weight: 800;
    }

    @@media (max-width: 991px) {
        .linka-order-info-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @@media (max-width: 575px) {
        .linka-detail-header {
            align-items: flex-start;
            flex-direction: column;
        }

        .linka-order-info-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="main-panel">

    <div class="content-wrapper linka-detail-page">

        <div class="linka-detail-header">

            <div>

                <h4 class="linka-detail-title">
                    Order Details
                </h4>

                <p class="linka-detail-subtitle">
                    Review the products and current status of your LINKA order.
                </p>

            </div>

            <a asp-area="User"
               asp-controller="MyOrder"
               asp-action="ActiveOrders"
               class="btn btn-outline-primary linka-back-btn">

                <i class="mdi mdi-arrow-left mr-1"></i>

                Back To My Orders

            </a>

        </div>

        <div class="linka-detail-card">

            <div class="linka-detail-card-header">

                <h5 class="linka-detail-card-title">
                    <i class="mdi mdi-receipt mr-1"></i>
                    Order Information
                </h5>

            </div>

            <div class="linka-order-info-grid">

                <div class="linka-order-info-item">

                    <span class="linka-order-info-label">
                        Order Number
                    </span>

                    <span class="linka-order-info-value">
                        @displayOrderNumber
                    </span>

                </div>

                <div class="linka-order-info-item">

                    <span class="linka-order-info-label">
                        Order Date
                    </span>

                    <span class="linka-order-info-value">
                        @(Model.OrderDate.ToString("dd.MM.yyyy HH:mm"))
                    </span>

                </div>

                <div class="linka-order-info-item">

                    <span class="linka-order-info-label">
                        Current Status
                    </span>

                    <span class="linka-order-status @statusClass">
                        @status
                    </span>

                </div>

                <div class="linka-order-info-item">

                    <span class="linka-order-info-label">
                        Paid Total
                    </span>

                    <span class="linka-order-info-value">
                        @(Model.TotalPrice.ToString("N2", culture)) ₺
                    </span>

                </div>

            </div>

        </div>

        <div class="linka-detail-card">

            <div class="linka-detail-card-header">

                <h5 class="linka-detail-card-title">
                    <i class="mdi mdi-shopping mr-1"></i>
                    Products
                </h5>

            </div>

            <div class="table-responsive">

                <table class="table linka-product-table">

                    <thead>
                        <tr>
                            <th>Product</th>
                            <th class="text-right">
                                Unit Price
                            </th>
                            <th class="text-center">
                                Quantity
                            </th>
                            <th class="text-right">
                                Line Total
                            </th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var item in Model.OrderDetails)
                        {
                            <tr>

                                <td>
                                    <span class="linka-product-name">
                                        @item.ProductName
                                    </span>
                                </td>

                                <td class="text-right">
                                    @(item.ProductPrice.ToString("N2", culture)) ₺
                                </td>

                                <td class="text-center">
                                    @item.ProductAmount
                                </td>

                                <td class="text-right font-weight-bold">
                                    @(item.ProductTotalPrice.ToString("N2", culture)) ₺
                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

            <div class="linka-detail-total-box">

                <div class="linka-detail-total-row">

                    <span>
                        Product Lines Total
                    </span>

                    <strong>
                        @(productSubTotal.ToString("N2", culture)) ₺
                    </strong>

                </div>

                <div class="linka-detail-total-row linka-detail-grand-total">

                    <span>
                        Paid Grand Total
                    </span>

                    <span>
                        @(Model.TotalPrice.ToString("N2", culture)) ₺
                    </span>

                </div>

            </div>

        </div>

    </div>

</div>
@model Linka.WebUI.Areas.User.Models.ChatViewModel

@{
    ViewData["Title"] = "Private Conversation";
    Layout = "~/Areas/User/Views/UserLayout/Index.cshtml";
}

<style>
    .linka-chat-card {
        overflow: hidden;
        border: 1px solid #e1e7f0;
        border-radius: 10px;
        background-color: #ffffff;
        box-shadow: 0 7px 18px rgba(35, 59, 101, 0.08);
    }

    .linka-chat-header {
        padding: 18px 22px;
        color: #ffffff;
        background: linear-gradient(135deg, #2946a3, #5175df);
    }

        .linka-chat-header h4 {
            margin-bottom: 5px;
            color: #ffffff;
            font-size: 18px;
            font-weight: 700;
        }

        .linka-chat-header p {
            margin-bottom: 0;
            color: rgba(255, 255, 255, 0.82);
            font-size: 12px;
        }

    .linka-chat-body {
        min-height: 430px;
        max-height: 560px;
        overflow-y: auto;
        padding: 22px;
        background-color: #f5f7fc;
    }

    .linka-message-row {
        display: flex;
        margin-bottom: 14px;
    }

        .linka-message-row.is-mine {
            justify-content: flex-end;
        }

        .linka-message-row.is-other {
            justify-content: flex-start;
        }

    .linka-message-bubble {
        max-width: 66%;
        padding: 11px 14px;
        border-radius: 13px;
        box-shadow: 0 3px 8px rgba(25, 45, 78, 0.06);
    }

    .linka-message-row.is-mine .linka-message-bubble {
        color: #ffffff;
        background-color: #3156ba;
        border-bottom-right-radius: 3px;
    }

    .linka-message-row.is-other .linka-message-bubble {
        color: #35495e;
        background-color: #ffffff;
        border-bottom-left-radius: 3px;
    }

    .linka-message-text {
        margin-bottom: 5px;
        font-size: 14px;
        line-height: 1.45;
        word-break: break-word;
    }

    .linka-message-date {
        display: block;
        font-size: 10px;
        opacity: 0.72;
        text-align: right;
    }

    .linka-chat-empty {
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 360px;
        color: #8d9bad;
        font-size: 14px;
        text-align: center;
    }

    .linka-chat-footer {
        padding: 15px 18px;
        border-top: 1px solid #e6ebf3;
        background-color: #ffffff;
    }

    .linka-chat-form {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .linka-chat-input {
        flex: 1;
        min-height: 44px;
        max-height: 110px;
        padding: 11px 14px;
        border: 1px solid #dce4ef;
        border-radius: 8px;
        color: #35495e;
        font-size: 14px;
        resize: vertical;
        outline: none;
    }

        .linka-chat-input:focus {
            border-color: #3156ba;
            box-shadow: 0 0 0 3px rgba(49, 86, 186, 0.10);
        }

    .linka-chat-send-button {
        height: 44px;
        padding: 0 19px;
        border: none;
        border-radius: 8px;
        color: #ffffff;
        background-color: #3156ba;
        font-size: 14px;
        font-weight: 700;
        transition: 0.2s ease;
    }

        .linka-chat-send-button:hover {
            background-color: #234395;
        }
</style>

<div class="content-wrapper">

    <div class="linka-chat-card">

        <div class="linka-chat-header">
            <h4>
                @Model.OtherUserDisplayName
            </h4>

            <p>
                Product:
                <a asp-area=""
                   asp-controller="ProductList"
                   asp-action="ProductDetail"
                   asp-route-id="@Model.ProductId"
                   style="color: white; text-decoration: underline;">
                    @Model.ProductName
                </a>
            </p>
        </div>

        <div class="linka-chat-body"
             id="chatBody">

            @if (Model.Messages.Any())
            {
                @foreach (var message in Model.Messages)
                {
                    var isMine =
                    message.SenderId == Model.CurrentUserId;

                    <div class="linka-message-row @(isMine ? "is-mine" : "is-other")">

                        <div class="linka-message-bubble">

                            <p class="linka-message-text">
                                @message.MessageDetail
                            </p>

                            <small class="linka-message-date">
                                @(message.MessageDate.ToLocalTime().ToString("dd MMM yyyy HH:mm"))
                            </small>

                        </div>

                    </div>
                }
            }
            else
            {
                <div class="linka-chat-empty">
                    There are no messages yet.<br />
                    Start the conversation by sending the first message.
                </div>
            }

        </div>

        <div class="linka-chat-footer">

            @if (TempData["MessageError"] != null)
            {
                <div class="alert alert-warning">
                    @TempData["MessageError"]
                </div>
            }

            <form asp-area="User"
                  asp-controller="Message"
                  asp-action="SendMessage"
                  method="post"
                  class="linka-chat-form">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       name="conversationId"
                       value="@Model.ConversationId" />

                <textarea name="messageDetail"
                          class="linka-chat-input"
                          placeholder="Type your message..."
                          required></textarea>

                <button type="submit"
                        class="linka-chat-send-button">

                    <i class="mdi mdi-send mr-1"></i>
                    Send

                </button>

            </form>

        </div>

    </div>

</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        const chatBody =
            document.getElementById('chatBody');

        if (chatBody) {
            chatBody.scrollTop =
                chatBody.scrollHeight;
        }
    });
</script>
@model Linka.WebUI.Models.AdminLayoutUserViewModel

<style>
    .linka-admin-header-title {
        display: flex;
        height: 50px;
        flex-direction: column;
        justify-content: center;
        margin-left: 18px;
    }

        .linka-admin-header-title strong {
            color: #ffffff;
            font-size: 14px;
            font-weight: 700;
        }

        .linka-admin-header-title span {
            color: rgba(255, 255, 255, 0.72);
            font-size: 11px;
        }

    .linka-admin-header-action {
        position: relative;
        display: flex !important;
        height: 50px;
        align-items: center;
        justify-content: center;
        padding-right: 14px !important;
        padding-left: 14px !important;
        color: #ffffff !important;
        font-size: 17px;
    }

        .linka-admin-header-action:hover {
            background-color: rgba(0, 0, 0, 0.08) !important;
        }

    .linka-admin-header-badge {
        position: absolute;
        top: 5px;
        right: 7px;
        min-width: 16px;
        height: 16px;
        padding: 0 4px;
        border-radius: 9px;
        color: #ffffff;
        background-color: #ff4f67;
        font-size: 10px;
        font-weight: 700;
        line-height: 16px;
        text-align: center;
    }

    .linka-admin-profile-button {
        display: flex !important;
        height: 50px;
        align-items: center;
        gap: 8px;
        padding-right: 15px !important;
        padding-left: 12px !important;
    }

    .linka-admin-header-avatar {
        width: 31px;
        height: 31px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border: 1px solid rgba(255, 255, 255, 0.25);
        border-radius: 50%;
        color: #ffffff;
        background: linear-gradient( 135deg, #2f6fc5, #23528f );
        font-size: 11px;
        font-weight: 800;
        letter-spacing: 0.4px;
    }

    .linka-admin-header-name {
        max-width: 145px;
        overflow: hidden;
        color: #ffffff;
        font-weight: 700;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .linka-admin-dropdown {
        width: 285px !important;
        padding-bottom: 6px !important;
        border: none !important;
        border-radius: 0 0 8px 8px !important;
        box-shadow: 0 8px 22px rgba(0, 0, 0, 0.17);
    }

    .linka-admin-dropdown-profile {
        padding: 17px 16px 14px;
        background-color: #f7f9fc;
    }

    .linka-admin-dropdown-avatar {
        width: 47px;
        height: 47px;
        display: flex;
        align-items: center;
        justify-content: center;
        float: left;
        margin-right: 11px;
        border-radius: 50%;
        color: #ffffff;
        background: linear-gradient( 135deg, #4c94e8, #2464bc );
        font-size: 14px;
        font-weight: 800;
    }

    .linka-admin-dropdown-full-name {
        display: block;
        overflow: hidden;
        color: #273444;
        font-size: 14px;
        font-weight: 800;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .linka-admin-dropdown-meta {
        display: block;
        overflow: hidden;
        color: #8492a6;
        font-size: 11px;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .linka-admin-role-badge {
        display: inline-block;
        margin-top: 5px;
        padding: 3px 8px;
        border-radius: 10px;
        color: #356aa7;
        background-color: #e3efff;
        font-size: 10px;
        font-weight: 800;
    }

    .linka-admin-dropdown > li > a,
    .linka-admin-dropdown-button {
        display: flex !important;
        width: 100%;
        align-items: center;
        gap: 9px;
        padding: 10px 15px !important;
        border: none;
        color: #667085 !important;
        background-color: transparent;
        font-size: 13px;
        text-align: left;
    }

        .linka-admin-dropdown > li > a:hover,
        .linka-admin-dropdown-button:hover {
            color: #2f6fc5 !important;
            background-color: #f1f6fd !important;
        }

    .linka-admin-dropdown i {
        width: 16px;
        text-align: center;
    }

    .linka-admin-dropdown > li > a i,
    .linka-admin-dropdown-button i {
        width: 17px;
        color: #527199 !important;
        font-size: 14px;
        text-align: center;
    }

    .linka-admin-dropdown > li > a:hover i,
    .linka-admin-dropdown-button:hover i {
        color: #2f6fc5 !important;
    }
</style>

<header class="main-header dark-bg">

    <a asp-area="Admin"
       asp-controller="Statistic"
       asp-action="Index"
       class="logo dark-bg">

        <span class="logo-mini">

            <img src="~/images/Logos/LinkaBlueLogo.png"
                 style="width:50px; height:50px;"
                 alt="LINKA">

        </span>

        <span class="logo-lg">

            <img src="~/images/Logos/LinkaBlueLogo.png"
                 style="width:200px; height:50px;"
                 alt="LINKA">

        </span>

    </a>

    <nav class="navbar navbar-static-top"
         role="navigation">

        <a href="#"
           class="sidebar-toggle"
           data-toggle="push-menu"
           role="button">

            <span class="sr-only">
                Toggle navigation
            </span>

        </a>

        <div class="pull-left linka-admin-header-title hidden-xs">

            <strong>
                LINKA Admin Control Center
            </strong>

            <span>
                Manage store content and operations
            </span>

        </div>

        <div class="navbar-custom-menu">

            <ul class="nav navbar-nav">

                <li>

                    <a asp-area="User"
                       asp-controller="Message"
                       asp-action="Index"
                       class="linka-admin-header-action"
                       title="My Messages">

                        <i class="fa fa-envelope-o"></i>

                        @if (Model.MessageCount > 0)
                        {
                            <span class="linka-admin-header-badge">
                                @Model.MessageCount
                            </span>
                        }

                    </a>

                </li>

                <li>

                    <a asp-area="Admin"
                       asp-controller="Comment"
                       asp-action="Index"
                       class="linka-admin-header-action"
                       title="Comments">

                        <i class="fa fa-comments-o"></i>

                        @if (Model.CommentCount > 0)
                        {
                            <span class="linka-admin-header-badge">
                                @Model.CommentCount
                            </span>
                        }

                    </a>

                </li>

                <li class="dropdown user user-menu">

                    <a href="#"
                       class="dropdown-toggle linka-admin-profile-button"
                       data-toggle="dropdown">

                        <span class="linka-admin-header-avatar">
                            @Model.Initials
                        </span>

                        <span class="hidden-xs linka-admin-header-name">
                            @Model.FullName
                        </span>

                    </a>

                    <ul class="dropdown-menu linka-admin-dropdown">

                        <li class="linka-admin-dropdown-profile">

                            <div class="linka-admin-dropdown-avatar">
                                @Model.Initials
                            </div>

                            <span class="linka-admin-dropdown-full-name">
                                @Model.FullName
                            </span>

                            <span class="linka-admin-dropdown-meta">
                                @Model.Username
                            </span>

                            <span class="linka-admin-dropdown-meta">
                                @Model.Email
                            </span>

                            <span class="linka-admin-role-badge">
                                @Model.RoleName
                            </span>

                            <div style="clear:both;"></div>

                        </li>

                        <li>

                            <a asp-area=""
                               asp-controller="Default"
                               asp-action="Index">

                                <i class="fa fa-home"></i>

                                Go To Store

                            </a>

                        </li>

                        <li>

                            <a asp-area="User"
                               asp-controller="Profile"
                               asp-action="Index">

                                <i class="fa fa-user"></i>

                                My User Panel

                            </a>

                        </li>

                        <li>

                            <a asp-area="User"
                               asp-controller="MyOrder"
                               asp-action="ActiveOrders">

                                <i class="fa fa-list-alt"></i>

                                My Orders

                            </a>

                        </li>

                        <li>

                            <a asp-area="User"
                               asp-controller="Message"
                               asp-action="Index">

                                <i class="fa fa-envelope-o"></i>

                                My Messages

                            </a>

                        </li>

                        <li role="separator"
                            class="divider">
                        </li>

                        <li>

                            <a asp-area="Admin"
                               asp-controller="User"
                               asp-action="UserList">

                                <i class="fa fa-users"></i>

                                User Management

                            </a>

                        </li>

                        <li role="separator"
                            class="divider">
                        </li>

                        <li>

                            <form asp-area=""
                                  asp-controller="Login"
                                  asp-action="LogOut"
                                  method="post"
                                  class="m-0">

                                @Html.AntiForgeryToken()

                                <button type="submit"
                                        class="linka-admin-dropdown-button">

                                    <i class="fa fa-sign-out"></i>

                                    Log Out

                                </button>

                            </form>

                        </li>

                    </ul>

                </li>

            </ul>

        </div>

    </nav>

</header>
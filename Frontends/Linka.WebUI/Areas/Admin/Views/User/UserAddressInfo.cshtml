@model GetCargoCustomerByIdDto

@{
    ViewData["Title"] = "Index";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}

<style>
    .customer-info-card {
        background: #ffffff;
        border-radius: 18px;
        box-shadow: 0 10px 30px rgba(47, 134, 191, 0.15);
        overflow: hidden;
        border: 1px solid #e6f2fb;
    }

    .customer-info-header {
        background: linear-gradient(135deg, #2f86bf, #59b4e8);
        color: #ffffff;
        padding: 28px 32px;
    }

        .customer-info-header h3 {
            margin: 0;
            font-weight: 700;
        }

        .customer-info-header p {
            margin: 8px 0 0;
            opacity: .9;
        }

    .info-grid {
        padding: 30px;
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 18px;
    }

    .info-box {
        background: #f5fbff;
        border: 1px solid #d9eefb;
        border-radius: 14px;
        padding: 18px 20px;
    }

    .info-label {
        color: #2f86bf;
        font-size: 13px;
        font-weight: 700;
        text-transform: uppercase;
        margin-bottom: 8px;
    }

    .info-value {
        color: #263238;
        font-size: 16px;
        font-weight: 600;
        word-break: break-word;
    }

    .address-box {
        grid-column: span 2;
    }

    .back-btn {
        margin-top: 22px;
        background: #2f86bf;
        color: white;
        border-radius: 10px;
        padding: 10px 24px;
        text-decoration: none;
        display: inline-block;
    }

        .back-btn:hover {
            background: #226d9c;
            color: white;
            text-decoration: none;
        }
</style>

<section class="content container-fluid">
    <div class="row">
        <div class="col-md-12">
            <div class="chart-box">

                <div class="customer-info-card">

                    <div class="customer-info-header">
                        <h3>User Address and Contact Info</h3>
                        <p>Detailed customer delivery and communication information</p>
                    </div>

                    <div class="info-grid">

                        <div class="info-box">
                            <div class="info-label">User ID</div>
                            <div class="info-value">@Model.cargoCustomerId</div>
                        </div>

                        <div class="info-box">
                            <div class="info-label">Name Surname</div>
                            <div class="info-value">@Model.name @Model.surname</div>
                        </div>

                        <div class="info-box">
                            <div class="info-label">Email Address</div>
                            <div class="info-value">@Model.email</div>
                        </div>

                        <div class="info-box">
                            <div class="info-label">Phone Number</div>
                            <div class="info-value">@Model.phone</div>
                        </div>

                        <div class="info-box">
                            <div class="info-label">District</div>
                            <div class="info-value">@Model.district</div>
                        </div>

                        <div class="info-box address-box">
                            <div class="info-label">Full Address</div>
                            <div class="info-value">@Model.address</div>
                        </div>

                    </div>
                </div>

            </div>
        </div>
    </div>
</section>
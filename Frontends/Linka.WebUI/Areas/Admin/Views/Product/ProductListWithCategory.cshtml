@model List<ResultProductWithCategoryDto>

@{
    ViewData["Title"] = "ProductListWithCategory";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
    int count = 0;
}

<section class="content container-fluid">
    <div class="row">
        <div class="col-md-12">
            <div class="chart-box">
                <div class="bs-example" data-example-id="bordered-table">
                    <table class="table">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Product Name</th>
                                <th>Product Price</th>
                                <th>Product Category</th>
                                <th>Delete</th>
                                <th>Update</th>
                                <th>Product Image</th>
                                <th>Description and Info</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                count++;
                                <tr>
                                    <th scope="row">@count</th>
                                    <td>@item.ProductName</td>
                                    <td>@item.ProductPrice</td>
                                    <td>@item.Category.CategoryName</td>

                                    <td><a href="/Admin/Product/DeleteProduct/@item.ProductId" class="btn btn-danger">Remove</a></td>
                                    <td><a href="/Admin/Product/UpdateProduct/@item.ProductId" class="btn btn-success">Update</a></td>
                                    <td><a href="/Admin/ProductImage/ProductImageOperation/@item.ProductId" class="btn btn-warning">Product Images</a></td>
                                    <td><a href="/Admin/ProductDetail/ProductDetailOperation/@item.ProductId" class="btn btn-info">Description and Info</a></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    <td><a href="/Admin/Product/CreateProduct/" class="btn btn-primary">Add New Product</a></td>
                </div>
            </div>
        </div>
    </div>
</section>



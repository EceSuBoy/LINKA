@using System.Globalization

@model PagedProductResultDto<ResultProductWithCategoryDto>

@{
    var culture =
        new CultureInfo(
            "tr-TR");

    var firstItem =
        Model.TotalCount == 0
            ? 0
            : ((Model.Page - 1) *
               Model.PageSize) + 1;

    var lastItem =
        Math.Min(
            Model.Page *
            Model.PageSize,
            Model.TotalCount);

    var firstVisiblePage =
        Math.Max(
            1,
            Model.Page - 2);

    var lastVisiblePage =
        Math.Min(
            Model.TotalPages,
            Model.Page + 2);

    var rowNumber =
        firstItem - 1;
}

<style>
    .linka-product-table-wrapper {
        overflow-x: auto;
    }

    .linka-product-table {
        min-width: 1240px;
        margin-bottom: 0;
    }

        .linka-product-table thead th {
            padding: 14px 12px;
            border-bottom: 1px solid #e7ecf1;
            color: #7b8798;
            font-size: 11px;
            font-weight: 800;
            letter-spacing: 0.45px;
            text-transform: uppercase;
            white-space: nowrap;
        }

        .linka-product-table tbody td {
            padding: 13px 12px;
            border-top: 1px solid #edf0f4;
            color: #3c4858;
            vertical-align: middle;
        }

        .linka-product-table tbody tr:hover {
            background-color: #fbfcfe;
        }

    .linka-product-row-number {
        width: 58px;
        min-width: 58px;
        padding-right: 16px !important;
        padding-left: 16px !important;
        color: #8492a6;
        font-weight: 700;
        text-align: center;
    }

    .linka-product-table thead th:first-child {
        width: 58px;
        min-width: 58px;
        padding-right: 16px !important;
        padding-left: 16px !important;
        text-align: center;
    }

    .linka-product-name {
        display: block;
        max-width: 390px;
        overflow: hidden;
        color: #273444;
        font-weight: 700;
        line-height: 1.35;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .linka-product-table thead th:nth-child(2),
    .linka-product-table tbody td:nth-child(2) {
        padding-left: 18px;
    }

    .linka-product-price {
        color: #273444;
        font-weight: 800;
        white-space: nowrap;
    }

    .linka-product-category-badge {
        display: inline-block;
        padding: 6px 10px;
        border-radius: 14px;
        color: #4169bd;
        background-color: #e5ecff;
        font-size: 11px;
        font-weight: 800;
    }

    .linka-product-operation-btn {
        min-width: 91px;
        border-radius: 6px;
        font-size: 12px;
        font-weight: 700;
    }

    .linka-product-table-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
        padding: 16px 20px;
        border-top: 1px solid #edf0f4;
        flex-wrap: wrap;
    }

    .linka-product-footer-info {
        color: #8492a6;
        font-size: 13px;
    }

    .linka-product-pagination {
        display: flex;
        gap: 5px;
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .linka-featured-badge,
    .linka-not-featured-badge {
        display: inline-block;
        min-width: 104px;
        padding: 6px 10px;
        border-radius: 14px;
        font-size: 11px;
        font-weight: 800;
        text-align: center;
        white-space: nowrap;
    }

    .linka-featured-badge {
        color: #8a6800;
        background-color: #fff3c4;
    }

    .linka-not-featured-badge {
        color: #7d8792;
        background-color: #f1f3f5;
    }

    .linka-featured-badge i {
        margin-right: 3px;
        color: #e3a300;
    }

    .linka-product-page-link {
        display: inline-flex;
        min-width: 34px;
        height: 34px;
        align-items: center;
        justify-content: center;
        border: 1px solid #dce3eb;
        border-radius: 6px;
        color: #64748b;
        background-color: #ffffff;
        font-size: 12px;
        font-weight: 700;
        text-decoration: none;
        transition: 0.2s;
    }

        .linka-product-page-link:hover,
        .linka-product-page-link.active {
            border-color: #4c94e8;
            color: #ffffff;
            background-color: #4c94e8;
            text-decoration: none;
        }

        .linka-product-page-link.disabled {
            pointer-events: none;
            opacity: 0.45;
        }

    .linka-product-empty-state {
        padding: 55px 18px;
        color: #8492a6;
        text-align: center;
    }

        .linka-product-empty-state i {
            display: block;
            margin-bottom: 12px;
            color: #c5ced9;
            font-size: 40px;
        }
</style>

@if (Model.Items.Any())
{
    <div class="linka-product-table-wrapper">

        <table class="table linka-product-table">

            <thead>

                <tr>
                    <th>#</th>
                    <th>Product Name</th>
                    <th>Price</th>
                    <th>Category</th>
                    <th>Featured</th>
                    <th>Delete</th>
                    <th>Update</th>
                    <th>Images</th>
                    <th>Description and Info</th>
                </tr>

            </thead>

            <tbody>

                @foreach (var item in Model.Items)
                {
                    rowNumber++;

                    <tr>

                        <td class="linka-product-row-number">
                            @rowNumber
                        </td>

                        <td>

                            <span class="linka-product-name"
                                  title="@item.ProductName">

                                @item.ProductName

                            </span>

                        </td>

                        <td>

                            <span class="linka-product-price">
                                @(item.ProductPrice.ToString("N2", culture)) ₺
                            </span>

                        </td>

                        <td>

                            <span class="linka-product-category-badge">

                                @(item.Category?.CategoryName
                                                        ?? "Unknown")

                    </span>

                        </td>

                        <td>

                    @if (item.IsFeatured)
                            {
                                <span class="linka-featured-badge">
                                    <i class="fa fa-star"></i>
                                    Featured #@item.FeaturedOrder
                                </span>
                            }
                            else
                            {
                                <span class="linka-not-featured-badge">
                                    Not Featured
                                </span>
                            }

                        </td>

                        <td>

                            <a asp-area="Admin"
                               asp-controller="Product"
                               asp-action="DeleteProduct"
                               asp-route-id="@item.ProductId"
                               class="btn btn-danger linka-product-operation-btn"
                               onclick="return confirm('Are you sure you want to delete this product?');">

                                <i class="fa fa-trash"></i>

                                Remove

                            </a>

                        </td>

                        <td>

                            <a asp-area="Admin"
                               asp-controller="Product"
                               asp-action="UpdateProduct"
                               asp-route-id="@item.ProductId"
                               class="btn btn-success linka-product-operation-btn">

                                <i class="fa fa-edit"></i>

                                Update

                            </a>

                        </td>

                        <td>

                            <a asp-area="Admin"
                               asp-controller="ProductImage"
                               asp-action="ProductImageListByProductId"
                               asp-route-id="@item.ProductId"
                               class="btn btn-warning linka-product-operation-btn">

                                <i class="fa fa-picture-o"></i>

                                Images

                            </a>

                        </td>

                        <td>

                            <a asp-area="Admin"
                               asp-controller="ProductDetail"
                               asp-action="UpdateProductDetail"
                               asp-route-id="@item.ProductId"
                               class="btn btn-info linka-product-operation-btn">

                                <i class="fa fa-info-circle"></i>

                                Details

                            </a>

                        </td>

                    </tr>
                        }

            </tbody>

        </table>

    </div>
}
else
{
    <div class="linka-product-empty-state">

        <i class="fa fa-search"></i>

        <h4>
            No matching products were found.
        </h4>

        <p>
            Try changing the product name or category filter.
        </p>

    </div>
}

<div class="linka-product-table-footer">

    <span class="linka-product-footer-info">

        Showing
        <strong>@firstItem</strong>
        -
        <strong>@lastItem</strong>
        of
        <strong>@Model.TotalCount</strong>
        products

    </span>

    @if (Model.TotalPages > 1)
    {
        <ul class="linka-product-pagination">

            <li>

                <a href="#"
                   data-product-page="@(Model.Page - 1)"
                   class="linka-product-page-link @(Model.Page <= 1 ? "disabled" : "")">

                    <i class="fa fa-angle-left"></i>

                </a>

            </li>

            @for (
                    var pageNumber =
                    firstVisiblePage;

                    pageNumber <=
                    lastVisiblePage;

                    pageNumber++)
            {
                <li>

                    <a href="#"
                       data-product-page="@pageNumber"
                       class="linka-product-page-link @(pageNumber == Model.Page ? "active" : "")">

                        @pageNumber

                    </a>

                </li>
            }

            <li>

                <a href="#"
                   data-product-page="@(Model.Page + 1)"
                   class="linka-product-page-link @(Model.Page >= Model.TotalPages ? "disabled" : "")">

                    <i class="fa fa-angle-right"></i>

                </a>

            </li>

        </ul>
    }

</div>
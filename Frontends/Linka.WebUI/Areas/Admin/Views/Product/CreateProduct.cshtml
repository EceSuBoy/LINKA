@model CreateProductDto

@{
    ViewData["Title"] = "CreateProduct";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}

<style>
    .category-select {
        height: 45px !important;
        min-height: 45px !important;
        line-height: 25px !important;
        padding: 10px 12px !important;
        font-size: 15px;
    }

    .linka-featured-settings {
        margin-top: 20px;
        padding: 18px;
        border: 1px solid #e4eaf1;
        border-radius: 10px;
        background-color: #fbfcfe;
    }

    .linka-featured-title {
        margin-top: 0;
        color: #273444;
        font-size: 17px;
        font-weight: 700;
    }

        .linka-featured-title i {
            margin-right: 6px;
            color: #f0ad4e;
        }
</style>

<section class="content container-fluid">
    <div class="row">
        <div class="col-md-12">
            <div class="chart-box">
                <h4>Product Add Page</h4>
                <br />

                <div class="bs-example" data-example-id="simple-table">
                    <form method="post">

                        <label>Product Name</label>
                        <input type="text" class="form-control" asp-for="ProductName" />
                        <br />

                        <label>Product Price</label>
                        <input type="text" class="form-control" asp-for="ProductPrice" />
                        <br />

                        <label>Product Discount Rate (%)</label>

                        <input type="number"
                               class="form-control"
                               asp-for="DiscountRate"
                               min="0"
                               max="100"
                               step="0.01"
                               placeholder="Enter 0 if this product has no discount" />

                        <span asp-validation-for="DiscountRate"
                              class="text-danger">
                        </span>

                        <br />

                        <label>Product Image</label>
                        <input type="text" class="form-control" asp-for="ProductImageUrl" />
                        <br />

                        <label>Product Category</label>
                        @Html.DropDownListFor(
                        x => x.CategoryId,
                                                (List<SelectListItem>)ViewBag.CategoryValues,
                                                new { @class = "form-control category-select" }
                                                )
                        <br />

                        <label>Product Description</label>
                        <textarea class="form-control" asp-for="ProductDescription" rows="5"></textarea>
                        <br />

                        <hr />

                        <div class="linka-featured-settings">

                            <h4 class="linka-featured-title">
                                <i class="fa fa-star"></i>
                                Featured Product Settings
                            </h4>

                            <p class="text-muted">
                                Select this option to display the product
                                in the Featured Products section on the home page.
                                A maximum of 8 products can be featured.
                            </p>

                            <div class="checkbox">

                                <label>

                                    <input asp-for="IsFeatured"
                                           type="checkbox"
                                           id="isFeaturedCheckbox" />

                                    Show in Featured Products

                                </label>

                            </div>

                            <div class="form-group"
                                 id="featuredOrderGroup">

                                <label>
                                    Featured Display Order
                                </label>

                                <input asp-for="FeaturedOrder"
                                       type="number"
                                       min="1"
                                       max="8"
                                       class="form-control"
                                       placeholder="Enter a value between 1 and 8" />

                                <small class="text-muted">
                                    Products with lower values appear first.
                                </small>

                            </div>

                        </div>

                        <button class="btn btn-primary">Add Product</button>

                    </form>
                    <script>
                        document.addEventListener(
                            "DOMContentLoaded",
                            function () {

                                const checkbox =
                                    document.getElementById(
                                        "isFeaturedCheckbox");

                                const orderGroup =
                                    document.getElementById(
                                        "featuredOrderGroup");

                                const orderInput =
                                    document.getElementById(
                                        "FeaturedOrder");

                                function updateFeaturedOrderVisibility() {
                                    const isFeatured =
                                        checkbox.checked;

                                    orderGroup.style.display =
                                        isFeatured
                                            ? "block"
                                            : "none";

                                    orderInput.disabled =
                                        !isFeatured;

                                    if (!isFeatured) {
                                        orderInput.value =
                                            "0";
                                    }
                                    else if (
                                        orderInput.value ===
                                        "0") {

                                        orderInput.value =
                                            "1";
                                    }
                                }

                                checkbox.addEventListener(
                                    "change",
                                    updateFeaturedOrderVisibility);

                                updateFeaturedOrderVisibility();
                            });
                    </script>

                </div>
            </div>
        </div>
    </div>
</section>